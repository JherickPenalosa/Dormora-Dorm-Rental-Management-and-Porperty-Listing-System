
# Dormora Backend - File 3
# Configuration template. Copy to backend/.env in File 4.
# Do not enter real passwords or secrets in this example file.

# General application settings
DORMORA_APP_NAME=Dormora API
DORMORA_APP_VERSION=0.1.0
DORMORA_ENVIRONMENT=development

# React development server origin (change if Vite uses another port)
DORMORA_FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL connection string for SQLAlchemy + Psycopg 3
# Replace CHANGE_ME with your database user's password in backend/.env only.
# Percent-encode special characters in the password (for example, @ becomes %40).
DORMORA_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/dormora_db
